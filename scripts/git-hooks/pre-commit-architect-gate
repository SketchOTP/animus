#!/usr/bin/env bash
# Block git commit when Architect diff + release gates are not fresh for the active request.
# Emergency override: ARCHITECT_GATE_OVERRIDE=1 ARCHITECT_GATE_OVERRIDE_REASON="..." git commit ...
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$repo_root"

architect_dir="$repo_root/.architect"
override_log="$architect_dir/gate_override.log"
check_script="$repo_root/scripts/architect_pre_commit_check.py"

if [[ "${ARCHITECT_GATE_OVERRIDE:-}" == "1" ]]; then
  reason="${ARCHITECT_GATE_OVERRIDE_REASON:-unspecified}"
  ts="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
  mkdir -p "$architect_dir"
  printf '%s override=1 reason=%q user=%s\n' "$ts" "$reason" "${USER:-unknown}" >>"$override_log"
  echo "architect-gate: OVERRIDE logged to .architect/gate_override.log" >&2
  exit 0
fi

if [[ ! -f "$check_script" ]]; then
  echo "architect-gate: BLOCKED — missing $check_script" >&2
  exit 1
fi

python3 "$check_script" "$architect_dir"
